# CampusAI - Environment Variables Template
# Copy this file to .env and replace the values with your actual keys.

# Google Gemini API Key
# Required for AI chatbot and intelligent routing
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3.5-flash-lite"

# Optional Planet imagery API key
PLANET_API_KEY="your-planet-api-key-here"
PLANET_MOSAIC_ID="your-planet-mosaic-id-here"

# (Optional) Map API keys if needed in the future
# MAPBOX_API_KEY="your-mapbox-key"
